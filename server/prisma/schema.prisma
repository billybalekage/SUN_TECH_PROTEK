generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
}

model Role {
    id          String @id @default(uuid())
    name        String @unique
    permissions Json   @default("[]")
    users       User[]
}

model User {
    id           String   @id @default(uuid())
    fullName     String
    email        String   @unique
    phone        String?
    company      String?
    passwordHash String?
    roleId       String
    role         Role     @relation(fields: [roleId], references: [id])
    isActive     Boolean  @default(true)
    createdAt    DateTime @default(now())
    updatedAt    DateTime @updatedAt

    projects      Project[]
    otpCodes      OtpCode[]
    refreshTokens RefreshToken[]
    auditLogs     AuditLog[]
    subscriptions Subscription[]
}

model OtpCode {
    id        String   @id @default(uuid())
    userId    String
    user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
    code      String
    expiresAt DateTime
    used      Boolean  @default(false)
    createdAt DateTime @default(now())
}

model RefreshToken {
    id        String    @id @default(uuid())
    userId    String
    user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
    tokenHash String    @unique
    jti       String    @unique
    familyId  String
    expiresAt DateTime
    usedAt    DateTime?
    revokedAt DateTime?
    createdAt DateTime  @default(now())

    @@index([userId])
    @@index([familyId])
}

model Manufacturer {
    id         String      @id @default(uuid())
    name       String
    country    String?
    components Component[]
}

model Component {
    id               String       @id @default(uuid())
    manufacturerId   String
    manufacturer     Manufacturer @relation(fields: [manufacturerId], references: [id], onDelete: Cascade)
    reference        String
    type             String
    ratedCurrent     Decimal?     @db.Decimal(10, 2)
    breakingCapacity Decimal?     @db.Decimal(10, 2)
    technicalSpecs   Json         @default("{}")
    createdAt        DateTime     @default(now())

    circuitComponents CircuitComponent[]
}

model NormRule {
    id            String   @id @default(uuid())
    code          String   @unique
    description   String?
    parameters    Json     @default("{}")
    effectiveDate DateTime
    createdAt     DateTime @default(now())

    calculationResults CalculationResult[]
}

model Project {
    id         String   @id @default(uuid())
    ownerId    String
    owner      User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
    clientName String
    address    String?
    contact    String?
    status     String   @default("DRAFT")
    createdAt  DateTime @default(now())
    updatedAt  DateTime @updatedAt

    installation Installation?
}

model Installation {
    id                   String   @id @default(uuid())
    projectId            String   @unique
    project              Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
    nominalVoltage       Decimal  @db.Decimal(6, 2)
    phaseType            String // "1N" ou "3N"
    neutralRegime        String // "TT","TN","IT"
    networkToTgdDistance Decimal? @db.Decimal(10, 2)
    installMode          String?
    insulationType       String?

    circuits Circuit[]
}

model Circuit {
    id                   String       @id @default(uuid())
    installationId       String
    installation         Installation @relation(fields: [installationId], references: [id], onDelete: Cascade)
    circuitType          String
    totalPower           Decimal      @db.Decimal(12, 2)
    farthestLoadDistance Decimal      @db.Decimal(10, 2)
    cosPhi               Decimal      @default(0.8) @db.Decimal(4, 3)
    numberOfCircuits     Int          @default(1)
    createdAt            DateTime     @default(now())

    calculationResult CalculationResult?
    circuitComponents CircuitComponent[]
}

model CircuitComponent {
    circuitId   String
    circuit     Circuit   @relation(fields: [circuitId], references: [id], onDelete: Cascade)
    componentId String
    component   Component @relation(fields: [componentId], references: [id], onDelete: Cascade)
    role        String // "PROTECTION" ou "CABLE"

    @@id([circuitId, componentId, role])
}

model CalculationResult {
    id            String    @id @default(uuid())
    circuitId     String    @unique
    circuit       Circuit   @relation(fields: [circuitId], references: [id], onDelete: Cascade)
    normRuleId    String?
    normRule      NormRule? @relation(fields: [normRuleId], references: [id])
    ib            Decimal   @db.Decimal(10, 2)
    deltaUPercent Decimal   @db.Decimal(6, 3)
    sectionMm2    Decimal   @db.Decimal(8, 2)
    inCurrent     Decimal   @db.Decimal(10, 2)
    izCurrent     Decimal   @db.Decimal(10, 2)
    icc           Decimal?  @db.Decimal(10, 2)
    isCompliant   Boolean   @default(false)
    computedAt    DateTime  @default(now())
}

model AuditLog {
    id        String   @id @default(uuid())
    userId    String?
    user      User?    @relation(fields: [userId], references: [id])
    action    String
    entity    String?
    entityId  String?
    metadata  Json     @default("{}")
    createdAt DateTime @default(now())
}

model Subscription {
    id        String    @id @default(uuid())
    userId    String
    user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
    plan      String
    status    String    @default("ACTIVE")
    startedAt DateTime  @default(now())
    expiresAt DateTime?
}
